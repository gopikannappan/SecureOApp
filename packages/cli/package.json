{
  "name": "secure-oapp",
  "version": "0.1.0",
  "description": "CLI for SecureOApp — scaffold, validate, deploy LayerZero OApps with enforced DVN profiles.",
  "license": "MIT",
  "author": "Gopi Kannappan",
  "repository": {
    "type": "git",
    "url": "https://github.com/gopikannappan/SecureOApp.git",
    "directory": "packages/cli"
  },
  "homepage": "https://secureoapp.dev",
  "type": "module",
  "bin": {
    "secure-oapp": "./dist/bin/secure-oapp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x ./dist/bin/secure-oapp.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@secure-oapp/core": "workspace:*",
    "commander": "^12.1.0",
    "picocolors": "^1.1.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
